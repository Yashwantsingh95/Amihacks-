# ==============================================================================
# RESCUEFLOW FRONTEND CONFIGURATION
# ==============================================================================

# Backend API Base URL (Default: http://localhost:5001/api)
# In production: https://api.rescueflow.example.com/api
VITE_API_URL=http://localhost:5001/api

# Google Maps JavaScript API Client Key
# Used for real-time interactive mapping, route polylines, and live location pins.
# If left blank, client gracefully renders high-contrast geospatial vector canvas.
VITE_GOOGLE_MAPS_API_KEY=

# OpenStreetMap / Leaflet Tile URL & Attribution
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OSM_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Google Identity Services / OAuth 2.0 Web Client ID
# Used for Google One-Tap & Google Sign-In button on login/signup pages.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

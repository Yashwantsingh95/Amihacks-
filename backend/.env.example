# ==============================================================================
# RESCUEFLOW BACKEND CONFIGURATION
# ==============================================================================

# Server Port
PORT=5001
NODE_ENV=development

# MongoDB Connection String (Leave blank to use embedded in-memory MongoDB)
# For production: mongodb+srv://<username>:<password>@cluster.mongodb.net/rescueflow?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret for Session & Token Encryption
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Client / Frontend Origin (For CORS and OAuth redirects)
# In production: https://rescueflow.example.com
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Google Maps Platform Server Key (Directions API & Geocoding API)
# If left blank, server gracefully uses OpenStreetMap / OSRM routing engine
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere
MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# Seed realistic demo donors, shelters, drivers and active rescues on startup
SEED_DEMO=true
